# --- LLM ---------------------------------------------------------------
LLM_PROVIDER=together
LLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
TOGETHER_API_KEY=

# Switch providers with zero code changes:
# LLM_PROVIDER=openai       + OPENAI_API_KEY=...
# LLM_PROVIDER=anthropic    + ANTHROPIC_API_KEY=...
# LLM_PROVIDER=self_hosted  + LLM_BASE_URL=http://localhost:8001/v1  + LLM_MODEL=...

# --- Embeddings (dimension must match the Pinecone index) --------------
EMBEDDING_PROVIDER=together
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# --- Pinecone ----------------------------------------------------------
PINECONE_API_KEY=pcsk_5y8eMh_7pZNrcic8rp8zVL13p5BKfxQnsYZ1sbhADqJCj3S5qSafhFGePkdoKPuzwBoDQz
# Created automatically (serverless, cosine) if it doesn't exist
PINECONE_INDEX_NAME=acme
# PINECONE_NAMESPACE=
PINECONE_TOP_K=4
PINECONE_MIN_SCORE=0.35

# --- Conversation memory ---------------------------------------------
# memory = in-process (lost on restart) | sqlite = persisted to a local file
CHECKPOINTER=sqlite
CHECKPOINT_SQLITE_PATH=data/checkpoints.db

# --- Store DB (products + orders) ---------------------------------------
# Unset = share the checkpointer's SQLite file above
# STORE_SQLITE_PATH=data/store.db

# --- Service -----------------------------------------------------------
LOG_LEVEL=INFO
# Log customer messages, answers and tool output (truncated). Set false if logs must not hold PII.
LOG_MESSAGE_CONTENT=true
LOG_PREVIEW_CHARS=200
REQUEST_TIMEOUT_SECONDS=90
GRAPH_RECURSION_LIMIT=12
